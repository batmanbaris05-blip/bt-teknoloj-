// Acilis: beyaz daire icinde 3D neon BT — ts boyutunda ciz (buyume icin)
void acilisBT(int ts, uint16_t faceCol){
  display.fillCircle(80,46,36,ST77XX_WHITE);         // daireyi temizle/ciz
  display.setTextSize(ts);
  int cx=80-6*ts, cy=46-4*ts;                         // ortala
  display.setTextColor(0x022A);                       // koyu teal golge (ekstruzyon=derinlik)
  display.setCursor(cx+2,cy+2);display.print("BT");
  display.setCursor(cx+1,cy+1);display.print("BT");
  display.setTextColor(faceCol);                      // neon yuz
  display.setCursor(cx,cy);display.print("BT");
  display.setTextColor(ST77XX_WHITE,ST77XX_BLACK);display.setTextSize(1);
}
void setup(){
  Serial.begin(115200);
  LittleFS.begin(true); // true = format if mount fails (first boot)
  pinMode(pinCLK,INPUT_PULLUP);pinMode(pinDT,INPUT_PULLUP);pinMode(pinSW,INPUT_PULLUP);
  attachInterrupt(digitalPinToInterrupt(pinCLK),encoderISR,CHANGE);
  attachInterrupt(digitalPinToInterrupt(pinDT),encoderISR,CHANGE);

  pinMode(buzzerPin,OUTPUT);digitalWrite(buzzerPin,LOW);pinMode(pilPin,INPUT);

   SPI.begin(TFT_CLK,-1,TFT_MOSI,TFT_CS);
   display.initR(INITR_BLACKTAB);
   display.setRotation(1);
   display.fillScreen(ST77XX_BLACK);
  // ── BEYAZ EKRANI ÖNLE ──
  display.fillScreen(ST77XX_BLACK);
  
  WiFi.mode(WIFI_OFF);delay(100);WiFi.mode(WIFI_AP);delay(100);
  WiFi.softAPConfig(IPAddress(192,168,4,1),IPAddress(192,168,4,1),IPAddress(255,255,255,0));
  WiFi.softAP(AP_SSID,AP_PASS,6,0,4);delay(200);
  // === ArduinoOTA: bilgisayardan Arduino IDE ile kablosuz yukleme ===
  ArduinoOTA.setHostname("BT-TECHNOLOGY");
  ArduinoOTA.onStart([](){ bipSus(); frekansUret(0); });
  ArduinoOTA.begin();
  Serial.print("[WiFi] IP: ");Serial.println(WiFi.softAPIP());
  server.on("/",HTTP_GET,handleRoot);server.on("/index.html",HTTP_GET,handleRoot);
  server.on("/manifest.json",HTTP_GET,handleManifest);server.on("/icon.svg",HTTP_GET,handleIcon);
  server.on("/sw.js",HTTP_GET,handleSW);
  server.on("/icon192.png",HTTP_GET,handleIcon192);
  server.on("/icon512.png",HTTP_GET,handleIcon512);
  server.on("/ping",HTTP_GET,handlePing);server.on("/ionic",HTTP_GET,handleIonic);
  server.on("/setfreq",HTTP_GET,handleSetFreq);server.on("/stop",HTTP_GET,handleStop);
  server.on("/setthresh",HTTP_GET,handleSetThresh);
  server.on("/calibrate",HTTP_GET,handleCalib);
  server.on("/status",HTTP_GET,handleStatus);
  server.on("/savescan",HTTP_POST,handleSaveScan);
  server.on("/listscans",HTTP_GET,handleListScans);
  server.on("/loadscan",HTTP_GET,handleLoadScan);
  server.on("/deletescan",HTTP_GET,handleDeleteScan);
  server.on("/update",HTTP_GET,handleOtaPage);
  server.on("/update",HTTP_POST,[](){
    bool ok=(!Update.hasError() && otaHataMsg=="");
    String msg = ok ? String("BASARILI! Cihaz yeniden baslatiliyor...")
                    : (String("HATA: ")+ (otaHataMsg!=""?otaHataMsg:otaHataSebep()));
    server.sendHeader("Connection","close");
    server.send(200,"text/plain",msg);
    if(ok){ delay(800); ESP.restart(); }
    else { // hatada: ekrana da yaz, restart yok, tekrar denenebilir
      otaAktif=false;
      display.fillScreen(ST77XX_BLACK); display.setFont(); display.setTextSize(1); display.setTextColor(ST77XX_RED,ST77XX_BLACK);
      display.setCursor(2,4); display.print("OTA HATASI:"); display.setTextColor(ST77XX_WHITE,ST77XX_BLACK);
      display.setCursor(2,18); display.print(msg.substring(0,220));
    }
  },[](){
    HTTPUpload& up=server.upload();
    if(up.status==UPLOAD_FILE_START){
      otaAktif=true; bipSus(); frekansUret(0); otaHataMsg=""; otaAlinanBayt=0;
      display.fillScreen(ST77XX_BLACK); display.setFont(); display.setTextSize(2); display.setTextColor(0x3D7F,ST77XX_BLACK);
      display.setCursor(6,40); display.print("GUNCELLE"); display.setTextSize(1); display.setCursor(6,70); display.print("Yukleniyor, bekleyin...");
      if(!Update.begin(UPDATE_SIZE_UNKNOWN)){ otaHataMsg=otaHataSebep(); Serial.println(otaHataMsg); }
    }
    else if(up.status==UPLOAD_FILE_WRITE){
      otaAlinanBayt+=up.currentSize;
      if(otaHataMsg=="" && Update.write(up.buf,up.currentSize)!=up.currentSize){ otaHataMsg=otaHataSebep(); Serial.println(otaHataMsg); }
    }
    else if(up.status==UPLOAD_FILE_END){
      if(otaHataMsg==""){ if(Update.end(true)) Serial.printf("OTA OK: %u bayt\n",up.totalSize); else { otaHataMsg=otaHataSebep(); Serial.println(otaHataMsg); } }
    }
  });
  server.onNotFound([](){server.send(404,"text/plain","Bulunamadi");});
  server.begin();Serial.println("[HTTP] Basladi");
   // ===== ACILIS ANIMASYONU — Neon BT BUYUME (~3.0 sn, millis ile zamanli) =====
   display.fillScreen(ST77XX_BLACK);
   // Sabit yazilar bir kez (daire/BT her kademede yeniden cizilir)
   display.setFont();
   display.setTextColor(ST77XX_WHITE,ST77XX_BLACK);
   display.setTextSize(1);display.setCursor(48,90);display.print("TECHNOLOGY");
   display.setTextColor(0x07FF,ST77XX_BLACK);display.setCursor(34,118);display.print(SURUM " OTA TEST ");
   display.setTextColor(ST77XX_WHITE,ST77XX_BLACK);
   display.drawRect(28,104,104,8,ST77XX_WHITE);
   display.fillCircle(80,46,36,ST77XX_WHITE); // beyaz daire

   unsigned long animBasla=millis();
   const unsigned long ANIM_SURE=3000; // toplam gorunur acilis suresi (3 sn)
   // Melodi (eski arpej) — acilis boyunca SURGUN dongu: bitince bastan calar
   int notalar[]={440,554,659,880,1109,1319,1760};
   int sure[]   ={90, 90, 90, 90, 90,  90,  200};
   int boyut[]  ={1,  2,  3,  4,  5,  5,   5};  // ilk turda BT kademe kademe buyur
   // 1) ILK TUR: BT en ufaktan buyur + melodi ilk gecis
   for(int i=0;i<7;i++){
     tone(buzzerPin,notalar[i],sure[i]);
     acilisBT(boyut[i], (i==6)?0xAFFF:0x07FF);                 // son notada parlak flash
     float fr=(millis()-animBasla)/(float)ANIM_SURE; if(fr>1)fr=1;
     display.fillRect(29,105,(int)(100*fr),6,0x07FF);
     delay(sure[i]+25);
   }
   acilisBT(5,0x07FF);  // BT neon haline otur (tam daireyi kaplar)
   // 2) KALAN SURE: melodiyi BASTAN AL (loop) — ses 3.5 sn boyunca hic susmaz
   int ni=0;
   while(millis()-animBasla < ANIM_SURE){
     int d=sure[ni];
     tone(buzzerPin,notalar[ni],d);
     float fr=(millis()-animBasla)/(float)ANIM_SURE; if(fr>1)fr=1;
     display.fillRect(29,105,(int)(100*fr),6,0x07FF);
     ni++; if(ni>=7) ni=0;       // melodi bitti -> bastan
     delay(d+25);
   }
   noTone(buzzerPin);
   pinMode(buzzerPin,OUTPUT); digitalWrite(buzzerPin,LOW);
   display.fillRect(29,105,100,6,0x07FF);
   anaMod=0;
   ekraniCiz();}


void loop(){
  ArduinoOTA.handle(); // kablosuz yukleme dinleyicisi
  if(otaAktif){ server.handleClient(); yield(); return; } // OTA sirasinda baska hicbir sey yapma (stabil yukleme)
  bipKontrol(); // sureli bip'leri zamaninda kapat
  // Encoder TEPKI — algilama artik KESME (ISR) icinde, anlik ve kesintisiz oluyor.
  // Burada sadece kesmenin biriktirdigi "tik" kuyrugu okunup harekete geciriliyor.
  int8_t tikler;
  noInterrupts();
  tikler=encTikKuyrugu;
  encTikKuyrugu=0;
  interrupts();
  if(tikler!=0 && !webBagliMi){
    int adim=abs(tikler);
    bool sagaMi=tikler>0;
    
    // Menu gecis sesi — EN ESKI HALI: sonar gibi "dit dit dit" (orijinal koddaki gibi)
    if(!ionicSurekli){
      for(int s=0; s<3; s++){
        tone(buzzerPin, 1800, 40);  // 40ms kisa ses
        delay(50);                   // 50ms bekleme
      }
      noTone(buzzerPin);
      pinMode(buzzerPin,OUTPUT); digitalWrite(buzzerPin,LOW); // tone() sonrasi pini normal cikisa al
    }
    
    for(int i=0;i<adim;i++){
      if(sagaMi){
        if(anaMod==0)menuSecim=constrain(menuSecim+1,1,4);
        else if(anaMod==2)metalSecim=(metalSecim+1)%11;
        else if(anaMod==3&&!manuelGirisBitti)serbestRakamlar[suankiHane]=(serbestRakamlar[suankiHane]+1+10)%10;
        else if(anaMod==4){esikVoltaj=constrain(esikVoltaj+0.10,0.10,3.00);esikVoltaj=round(esikVoltaj*10)/10.0;}
      }else{
        if(anaMod==0)menuSecim=constrain(menuSecim-1,1,4);
        else if(anaMod==2)metalSecim=(metalSecim+10)%11;
        else if(anaMod==3&&!manuelGirisBitti)serbestRakamlar[suankiHane]=(serbestRakamlar[suankiHane]+9)%10;
        else if(anaMod==4){esikVoltaj=constrain(esikVoltaj-0.10,0.10,3.00);esikVoltaj=round(esikVoltaj*10)/10.0;}
      }
    }
    ekraniCiz(false);
  }

  server.handleClient();baglantiKontrol();
  if(webBagliMi){if(millis()-sonEkranZamani>2000){ekraniCiz();sonEkranZamani=millis();}yield();return;}

  static bool sonButon=HIGH;
  bool buton=digitalRead(pinSW);
  bool basildi=(buton==LOW && sonButon==HIGH && millis()-sonButonZamani>200); // sadece BASILDIGI AN bir kez — basili tutunca tekrar tekrar tetiklemez
  sonButon=buton;
  if(basildi){sonButonZamani=millis();
    if(anaMod==3&&!manuelGirisBitti){
      suankiHane++;
      if(suankiHane>4){
        manuelGirisBitti=true;
        // Girilen frekansı hemen üret
        long fSerbest=serbestHz();   // 100-50000 Hz (telefonla ayni)
        if(fSerbest>0) frekansUret(fSerbest);
      }
    }
    else{frekansUret(0);bipSus();ionicSurekli=false;anaMod=(anaMod==0)?menuSecim:0;suankiHane=0;manuelGirisBitti=false;}
    tik();ekraniCiz(false);}    // buton: sadece kisa 'tik'
  if(anaMod==1){suzulmusVoltaj=(suzulmusVoltaj*0.75f)+(max(0.0f,((analogRead(sensorPin)*3.3f)/4095.0f)-0.2f)*0.25f); // taban 0.75 -> 0.2: tavan artik 3.1V'a kadar cikabiliyor, 3.0V kademesine ulasilabiliyor
    float lrlKalibreliV = max(0.0f, suzulmusVoltaj - groundOffset); // kalibrasyon (zemin sifirlama) artik gercekten uygulaniyor
    // 3 KADEME SES: zayif=hizlanan bip, guclu=hizlanan kesik, cok guclu=surekli
    int kademe = lrlKalibreliV<esikVoltaj ? 0 : lrlKalibreliV<1.5f ? 1 : lrlKalibreliV<3.0f ? 2 : 3;
    ionicSesGuncelle(kademe, lrlKalibreliV);
    // Ekran yenileme 300ms -> 100ms: gorsel (kirmizi nokta/ibre) artik sesle
    // ES ZAMANLI guncelleniyor, "once lamba sonra ses" gecikmesi ortadan kalkti.
    if(millis()-sonEkranZamani>100){ekraniCiz();sonEkranZamani=millis();}}
  if(anaMod==2||(anaMod==3&&manuelGirisBitti)){
    long f=(anaMod==2)?frekanslar[metalSecim]:serbestHz();
    frekansUret(f);
    
    // Sonar ibresi dönerken arka planda çok hafif tek "tik" sesi
    // Her 1500ms'de bir kısa tik çal (minimum sesle)
    if(millis()-sonarSesZamani>1500){
      bip(10);  // cok kisa tik
      sonarSesZamani=millis();
    }
    
    if(millis()-sonEkranZamani>180){animasyonSayac=(animasyonSayac+1)%36;ekraniCiz(true);sonEkranZamani=millis();}} // 80->180: cihaz radari daha yavas doner
  // Ana menu ve esik modu — her 500ms yenile (pil gostergesi icin)
  if(anaMod==0||anaMod==4){
    if(millis()-sonEkranZamani>500){ekraniCiz();sonEkranZamani=millis();}}
  yield(); // FreeRTOS/WiFi gorevlerine nefes payi — delay(1) yerine, encoder pollingini kesintiye ugratmadan watchdog'u besler
}