    if(sonAnaMod==1 && anaMod!=1){ bipSus(); ionicSurekli=false; } // IONIC'ten cikarken sesi kesinlikle sustur
    display.fillScreen(ST77XX_BLACK);
    sonAnaMod=anaMod;
    sonManuelBitti=manuelGirisBitti;
    pilFiltre=0;sonPct=-1; // pil yeniden cizilsin
    lrlBaslatildi=false;   // LRL moduna tekrar girilirse mavi zemin yeniden boyansin
  }

  // PIL — sag ust, sadece 3 saniyede bir okunur (pil hizli degismez, her ekraniCiz()
  // cagrisinda okumak gereksiz yuk — ozellikle LRL modunda 100ms'de bir calisiyordu)
  {
    static unsigned long sonPilOkuma=0;
    if(millis()-sonPilOkuma>3000 || sonPct==-1){
      sonPilOkuma=millis();
      int v=analogRead(pilPin);
      int y=constrain(map(v,461,646,0,100),0,100); // kalibre edildi: gercek olcum (569 ham = 3.7V) uzerinden, 461=bos(3.0V) 646=dolu(4.2V)
      if(pilFiltre==0)pilFiltre=y;
      pilFiltre=(pilFiltre*0.9)+(y*0.1);
      int pct=(int)(pilFiltre+0.5f);
      if(pct!=sonPct){
        sonPct=pct;
        uint16_t pilRenk = pct>50 ? 0x07E0 : pct>20 ? 0xFFE0 : 0xF800;
        display.fillRect(134,1,26,10,ST77XX_BLACK);
        display.drawRect(136,2,20,8,ST77XX_WHITE);
        display.fillRect(137,3,map(pct,0,100,0,18),6,pilRenk);
        display.fillRect(137+map(pct,0,100,0,18),3,18-map(pct,0,100,0,18),6,ST77XX_BLACK);
        display.fillRect(156,4,3,4,ST77XX_WHITE);
      }
    }
  }

  if(webBagliMi){
    display.setTextColor(0x07FF,ST77XX_BLACK); // cyan
    display.setTextSize(1);
    display.setCursor(18,20);display.print("** WEB MODU **   ");
    display.drawLine(0,30,160,30,0x07FF);
    display.setTextColor(ST77XX_WHITE,ST77XX_BLACK);
    display.setCursor(5,40);display.print("Telefon kontrolde");
    display.setTextColor(0xFFE0,ST77XX_BLACK); // sari
    display.setCursor(5,52);display.print("192.168.4.1      ");
    return;
  }

  if(anaMod==0){
    // ANA MENU — yumusak FreeSansBold9pt yazi; sadece secim degisince cizilir
    static int sonMenu=-1;
    if(ekranYeni){ baslikCiz(); sonMenu=-1; }
    if(menuSecim!=sonMenu){
      static const char* adlar[4]={"IONIC","FREKANS","SERBEST","ESIK"};
      display.setTextSize(1);
      display.setFont(&FreeSansBold9pt7b);
      for(int i=0;i<4;i++){
        int y=22+i*26; bool sec=(menuSecim==i+1);
        display.fillRect(0,y,160,24, sec ? 0x07E0 : ST77XX_BLACK);
        display.setTextColor(sec ? ST77XX_BLACK : ST77XX_WHITE);
        display.setCursor(sec ? 6 : 16, y+18);
        if(sec) display.print("> ");
        display.print(adlar[i]);
      }
      display.setFont();
      sonMenu=menuSecim;
    }

  }else if(anaMod==1){
    // IONIC MODU — WiFi GOSTERGESI
    //  sol: nokta + 3 yay (yesil=zayif, sari=guclu, kirmizi=cok guclu)
    //  sag: durum etiketi, buyuk sinyal yuzdesi, altta 3 daire
    // Yaylar/daireler sadece KADEME degisince, yuzde sadece DEGER degisince cizilir.
    const int WX=9, WY=66;
    static const int YAY[3][2]={{12,25},{33,46},{54,69}};
    static const uint16_t ACIK[3]={0x07E0,0xFFE0,ST77XX_RED};
    static const uint16_t SONUK[3]={0x01A0,0x2940,0x2800};
    const uint16_t GRI=0x8410, CIZGI=0x2104;
    static int sonSeviye=-1, sonTepeSeviye=-1, sonYuzde=-1;
    static float tepe=0, sonEsikCiz=-1;
    static unsigned long tepeZamani=0;
    float gv=max(0.0f, suzulmusVoltaj-groundOffset);
    int seviye = gv<esikVoltaj ? 0 : gv<1.5f ? 1 : gv<3.0f ? 2 : 3;
    if(gv>=tepe){tepe=gv;tepeZamani=millis();}
    else if(millis()-tepeZamani>1500){tepe=max(gv,tepe-0.05f);}
    int tepeSeviye = tepe<esikVoltaj ? 0 : tepe<1.5f ? 1 : tepe<3.0f ? 2 : 3;

    if(!lrlBaslatildi){
      baslikCiz();
      sonSeviye=-1; sonTepeSeviye=-1; sonYuzde=-1; sonEsikCiz=-1; tepe=0;
      lrlBaslatildi=true;
    }

    if(seviye!=sonSeviye || tepeSeviye!=sonTepeSeviye){
      // durum etiketi
      static const char* etiket[4]={"SINYAL YOK","ZAYIF","GUCLU","COK GUCLU"};
      static const uint16_t zemin[4]={0x2104,0x07E0,0xFFE0,ST77XX_RED};
      static const uint16_t yazi[4]={0x8410,ST77XX_BLACK,ST77XX_BLACK,ST77XX_WHITE};
      display.fillRect(96,23,62,13,zemin[seviye]);
      display.setTextSize(1);
      display.setTextColor(yazi[seviye],zemin[seviye]);
      display.setCursor(96+(62-(int)strlen(etiket[seviye])*6)/2,26);display.print(etiket[seviye]);
      // WiFi: nokta + yaylar (+ tepe izi: ulasilmis ama simdi sonuk yayin dis kenari beyaz)
      display.fillCircle(WX,WY,6, ST77XX_WHITE); // beyaz nokta HER ZAMAN gorunur (sinyal yokken de)
      for(int i=0;i<3;i++){
        yayCiz(WX,WY,YAY[i][0],YAY[i][1], seviye>i ? ACIK[i] : SONUK[i]);
        if(tepeSeviye>i && seviye<=i) yayCiz(WX,WY,YAY[i][1]-1,YAY[i][1],ST77XX_WHITE);
      }
      // alttaki 3 daire
      for(int i=0;i<3;i++){
        int x=108+i*20;
        display.fillCircle(x,119,7, seviye>i ? ACIK[i] : SONUK[i]);
        display.drawCircle(x,119,7, seviye>i ? ST77XX_WHITE : 0x4208);
      }
      sonSeviye=seviye; sonTepeSeviye=tepeSeviye;
      sonYuzde=-1; // yuzdenin rengi degisti, yeniden ciz
    }

    // buyuk sinyal yuzdesi (0-3V -> %0-100), yumusak FreeSans yazi
    static char sonYazi[5]="";
    static int sonX=0;
    int yuzde; if(gv<3.0f) yuzde=constrain((int)(gv/3.0f*85.0f+0.5f),0,85); else yuzde=constrain((int)(85.0f+(gv-3.0f)/0.1f*15.0f+0.5f),85,100); // 3. led yanmadan %100 verme
    if(yuzde!=sonYuzde){
      uint16_t renk = seviye==0 ? ST77XX_WHITE : seviye==1 ? 0x07E0 : seviye==2 ? 0xFFE0 : ST77XX_RED;
      char yazi[5]; snprintf(yazi,sizeof(yazi),"%d",yuzde);
      if(sonYazi[0]) yuzdeYaz(sonYazi,sonX,ST77XX_BLACK);   // eskisini sil
      int x=121-yuzdeGenislik(yazi)/2;
      yuzdeYaz(yazi,x,renk);
      strcpy(sonYazi,yazi); sonX=x; sonYuzde=yuzde;
    }

  }else if(anaMod==2||(anaMod==3&&manuelGirisBitti)){
    // FREKANS / SERBEST MODU — isim ve deger sadece DEGISINCE cizilir, radar her karede doner
    static long sonFCiz=-1; static int sonMetalCiz=-1;
    long fVal=(anaMod==2)?frekanslar[metalSecim]:serbestHz();
    if(ekranYeni){ baslikCiz(); sonFCiz=-1; }
    int metalId=(anaMod==2)?metalSecim:-2;
    if(fVal!=sonFCiz || metalId!=sonMetalCiz){
      display.fillRect(0,21,112,24,ST77XX_BLACK);   // isim alani
      display.fillRect(0,46,82,46,ST77XX_BLACK);    // deger + birim alani (radarin solu)
      display.setTextSize(1);
      display.setFont(&FreeSansBold9pt7b); display.setTextColor(0xFFE0);
      display.setCursor(5,39); display.print(anaMod==2 ? metaller[metalSecim] : "SERBEST");
      char deger[12]; const char* birim;
      frekansMetni(fVal,deger,sizeof(deger),&birim);
      display.setFont(&FreeSansBold12pt7b); display.setTextColor(ST77XX_WHITE);
      display.setCursor(5,70); display.print(deger);
      display.setFont(&FreeSansBold9pt7b); display.setTextColor(0x07FF);
      display.setCursor(5,90); display.print(birim);
      display.setFont();
      sonFCiz=fVal; sonMetalCiz=metalId;
    }
    if(radarGoster){
      halkaCiz(118,90,2,(float)(animasyonSayac%36));
    }

  }else if(anaMod==3&&!manuelGirisBitti){
    // SERBEST GIRIS
    // Baslik sadece ilk giriste ciziyor (fillScreen sonrasi)
    display.setTextColor(0x07FF,ST77XX_BLACK);
    display.setTextSize(1);
    display.setCursor(5,2);display.print("SERBEST FREKANS");
    display.drawLine(0,12,160,12,0x07FF);
    display.setTextColor(ST77XX_WHITE,ST77XX_BLACK);
    display.setCursor(5,16);display.print("5 rakam girin:");
    // Rakam kutucuklari — her biri kendi alanini temizleyerek ciziliyor
    display.setTextSize(2);
    for(int i=0;i<5;i++){
      int rx=4+(i*30);
      if(suankiHane==i){
        display.fillRect(rx,28,24,20,0x07E0);
        display.setTextColor(ST77XX_BLACK,0x07E0);
      }else{
        display.fillRect(rx,28,24,20,ST77XX_BLACK);
        display.drawRect(rx,28,24,20,0x07FF);
        display.setTextColor(0x07FF,ST77XX_BLACK);
      }
      display.setCursor(rx+4,30);
      display.print(serbestRakamlar[i]);
    }
    // Toplam frekans satiri
    long fG=serbestRakamlar[0]*10000L+serbestRakamlar[1]*1000L+
            serbestRakamlar[2]*100L+serbestRakamlar[3]*10L+serbestRakamlar[4];
    display.setTextColor(0xFFE0,ST77XX_BLACK);
    display.setTextSize(1);
    display.setCursor(5,52);
    display.print("= ");display.print(fG);display.print(" Hz      ");
    // aralik disindaysa uyar (cikis 100-50000 Hz'e sinirlanir — telefonla ayni)
    display.setCursor(5,84);
    if(fG!=0 && (fG<100 || fG>50000)){display.setTextColor(ST77XX_RED,ST77XX_BLACK);display.print("100-50000 Hz arasi!");}
    else display.print("                   ");
    display.setTextColor(0x4208,ST77XX_BLACK);
    display.setCursor(5,64);display.print("Bas: sonraki hane  ");
    display.setCursor(5,74);display.print("Menu: geri don     ");

  }else if(anaMod==4){
    // ESIK AYARI
    display.setTextColor(0x07FF,ST77XX_BLACK);
    display.setTextSize(1);
    display.setCursor(5,2);display.print("ESIK AYARI");
    display.drawLine(0,12,160,12,0x07FF);
    display.setTextColor(ST77XX_WHITE,ST77XX_BLACK);
    display.setCursor(5,16);display.print("< Encoder ile ayarla >");
    // Esik degeri — buyuk sari
    display.setTextColor(0xFFE0,ST77XX_BLACK);
    display.setTextSize(3);
    display.setCursor(5,30);display.print(esikVoltaj,2);
    display.setTextColor(0x07FF,ST77XX_BLACK);
    display.setTextSize(1);
    display.setCursor(88,38);display.print("Volt ");
    // Bar gosterge
    int barW=map((int)(esikVoltaj*100),10,300,0,148);
    display.drawRect(5,62,150,8,ST77XX_WHITE);
    display.fillRect(6,63,barW,6,0x07E0);
    display.fillRect(6+barW,63,148-barW,6,ST77XX_BLACK);
    display.setTextColor(ST77XX_WHITE,ST77XX_BLACK);
    display.setCursor(5,76);display.print("Min:0.10V  Max:3.00V");
    display.setCursor(5,88);display.print("Aktif esik degeri");
  }
}

