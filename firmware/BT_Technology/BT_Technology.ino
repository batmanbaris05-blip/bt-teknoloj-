// SERBEST frekans: girilen 5 rakam, telefonla ayni araliga sinirlanir (100 - 50000 Hz). 0 = cikis yok.
long serbestHz(){
  long f=serbestRakamlar[0]*10000L+serbestRakamlar[1]*1000L+serbestRakamlar[2]*100L+serbestRakamlar[3]*10L+serbestRakamlar[4];
  if(f==0) return 0;
  return constrain(f,100L,50000L);
}

