  if(once==webBagliMi)return;
  if(webBagliMi){bipSus();ionicSurekli=false;bipBekle(70);delay(150);bipBekle(70);tamYenile=true;ekraniCiz();} // baglanti sesi: daha yavas/sakin ikili "dut dut"
  else{webFreqAktif=false;webHz=0;frekansUret(0);bipBekle(250);tamYenile=true;ekraniCiz();}}
