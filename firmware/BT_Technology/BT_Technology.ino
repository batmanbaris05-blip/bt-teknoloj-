void handleIonic(){
  // Ham sensör oku — her zaman, webBagliMi olsa bile
  int raw=analogRead(sensorPin);
  float voltHam=max(0.0f,((raw*3.3f)/4095.0f)-0.2f); // 0.75 -> 0.2: eski taban degeri tavani 2.55V'ta sabitliyordu, 3.0V'a hic ulasamiyordu
  // Filtreleme — webBagliMi olsa bile güncelle (hassasiyet dusuruldu: %45 -> %25 yeni veri agirligi)
  suzulmusVoltaj=suzulmusVoltaj*0.75f+voltHam*0.25f; // hassasiyet cok az artirildi: %80/%20 -> %75/%25
  float volt=suzulmusVoltaj;
  float groundVolt=max(0.0f,volt-groundOffset);
  float fluxDev=volt-groundOffset; // FLUXGATE: isaretli sapma (tarama modu icin, kirpilmamis)
  int level=(groundVolt<esikVoltaj)?0:(groundVolt<1.5f)?1:(groundVolt<3.0f)?2:3; // cihaz ekrani/buzzer ile ayni kademe
  // PIL — cihaz ekranindaki (pilCiz) ile BIREBIR AYNI formul ve filtre kullanilir,
  // boylece telefonda gorunen yuzde ile cihazin kendi ekranindaki yuzde HER ZAMAN esit olur.
  // Sadece 3 saniyede bir okunur — pil hizli degismez, telefon her ~700ms sordugu icin
  // her seferinde okumak gereksiz yuk olurdu.
  static unsigned long sonPilOkumaWeb=0;
  static int sonPilRawWeb=0;
  if(millis()-sonPilOkumaWeb>3000){
    sonPilOkumaWeb=millis();
    sonPilRawWeb=analogRead(pilPin);
    int pilY=constrain(map(sonPilRawWeb,461,646,0,100),0,100); // kalibre edildi: gercek olcum (569 ham = 3.7V) uzerinden, 461=bos(3.0V) 646=dolu(4.2V)
    if(pilFiltre==0)pilFiltre=pilY;
    pilFiltre=(pilFiltre*0.9)+(pilY*0.1);
  }
  int pilPct=(int)(pilFiltre+0.5f);
  char json[256];
  snprintf(json,sizeof(json),"{\"adc\":%d,\"volt\":%.2f,\"level\":%d,\"thr\":%.2f,\"groundvolt\":%.2f,\"offset\":%.2f,\"pil\":%d,\"pilraw\":%d,\"fluxdev\":%.3f}",raw,volt,level,esikVoltaj,groundVolt,groundOffset,pilPct,sonPilRawWeb,fluxDev);
  server.send(200,"application/json",json);
}
void handleSetThresh(){
  if(server.hasArg("val")){
    float v=server.arg("val").toFloat();
    if(v>=0.1f&&v<=3.0f)esikVoltaj=v;
  }
  server.send(200,"application/json","{\"ok\":true}");
}
void handleCalib(){
  // Mevcut filtrelenmis voltaji zemin referansi olarak kaydet (?clear=1 -> ofseti kaldir)
  if(server.hasArg("clear")) groundOffset=0;
  else groundOffset=suzulmusVoltaj;
  char json[80];
  snprintf(json,sizeof(json),"{\"ok\":true,\"offset\":%.2f}",groundOffset);
  server.send(200,"application/json",json);
}
void handleSetFreq(){if(!server.hasArg("hz")){server.send(400,"application/json","{\"error\":\"hz eksik\"}");return;}
  long hz=constrain((long)server.arg("hz").toInt(),100L,50000L);webHz=hz;webFreqAktif=true;frekansUret(hz);
  char json[50];snprintf(json,sizeof(json),"{\"ok\":true,\"hz\":%ld}",hz);server.send(200,"application/json",json);}
void handleStop(){webFreqAktif=false;webHz=0;frekansUret(0);server.send(200,"application/json","{\"ok\":true}");}
void handleStatus(){int raw=analogRead(sensorPin);float volt=max(0.0f,((raw*3.3f)/4095.0f)-0.2f);
  char json[200];snprintf(json,sizeof(json),"{\"webBagli\":%s,\"volt\":%.2f,\"adc\":%d}",webBagliMi?"true":"false",volt,raw);server.send(200,"application/json",json);}

// ══ TARAMA KAYIT SİSTEMİ (LittleFS) — yalnızca ekleme, mevcut sistemi etkilemez ══
void handleSaveScan(){
  if(!server.hasArg("data")){server.send(400,"application/json","{\"error\":\"data eksik\"}");return;}
  String data=server.arg("data");
  String name=server.hasArg("name")?server.arg("name"):"Tarama";
  // Güvenli dosya adı oluştur
  String fname="/scan_"+String(millis())+".json";
  File f=LittleFS.open(fname,"w");
  if(!f){server.send(500,"application/json","{\"error\":\"dosya acilamadi\"}");return;}
  f.print(data);
  f.close();
  char json[160];
  snprintf(json,sizeof(json),"{\"ok\":true,\"file\":\"%s\"}",fname.c_str());
  server.send(200,"application/json",json);
}
void handleListScans(){
  String out="[";
  bool first=true;
  File root=LittleFS.open("/");
  File file=root.openNextFile();
  while(file){
    String fn=String(file.name());
    if(fn.startsWith("scan_")||fn.startsWith("/scan_")){
      if(!first)out+=",";
      first=false;
      out+="{\"file\":\""+(fn.startsWith("/")?fn:("/"+fn))+"\",\"size\":"+String(file.size())+"}";
    }
    file=root.openNextFile();
  }
  out+="]";
  server.send(200,"application/json",out);
}
bool scanAdiGuvenli(String& fn){ if(!fn.startsWith("/"))fn="/"+fn; return fn.startsWith("/scan_") && fn.indexOf("/",1)==-1 && fn.indexOf("..")==-1; }
void handleLoadScan(){
  if(!server.hasArg("file")){server.send(400,"application/json","{\"error\":\"file eksik\"}");return;}
  String fname=server.arg("file");
  if(!scanAdiGuvenli(fname)){server.send(400,"application/json","{\"error\":\"gecersiz ad\"}");return;}
  File f=LittleFS.open(fname,"r");
  if(!f){server.send(404,"application/json","{\"error\":\"bulunamadi\"}");return;}
  server.streamFile(f,"application/json");
  f.close();
}
void handleDeleteScan(){
  if(!server.hasArg("file")){server.send(400,"application/json","{\"error\":\"file eksik\"}");return;}
  String fname=server.arg("file");
  if(!scanAdiGuvenli(fname)){server.send(400,"application/json","{\"error\":\"gecersiz ad\"}");return;}
  if(LittleFS.exists(fname)){LittleFS.remove(fname);server.send(200,"application/json","{\"ok\":true}");}
  else server.send(404,"application/json","{\"error\":\"bulunamadi\"}");
}

